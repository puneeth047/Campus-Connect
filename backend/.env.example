# Organizer login (required for scanner authentication)
ORGANIZER_EMAIL=organizer@example.com
ORGANIZER_PASSWORD=change-this-password
JWT_SECRET=replace-with-a-long-random-string

# Optional SMTP for ticket emails.
# Without SMTP, registration still works — QR is shown on confirmation screen.
# Resend example:
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_USER=resend
# SMTP_PASS=re_your_api_key
# SMTP_FROM=CampusConnect <tickets@your-verified-domain.example>
